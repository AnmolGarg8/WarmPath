# WarmPath Demo Profile Configuration Overrides
# Copy to backend/.env when running shortened demo presentations.
# To return to production settings, remove or set DEMO_PROFILE=false.

DEMO_PROFILE=true
TEST_MODE=true

# Shortened timing windows for live 4-minute demo flow
DISPUTE_WINDOW_MINUTES=2
NO_REPLY_EXPIRY_MINUTES=5
MIN_CALL_SECONDS=60
SCHEDULER_INTERVAL_SECONDS=15

# Lowered band thresholds for fast progression demonstration
TRUSTED_MIN_SESSIONS=1
TOP_RATED_MIN_SESSIONS=2

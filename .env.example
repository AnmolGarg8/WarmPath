# Core Infrastructure
DATABASE_URL=postgresql+asyncpg://warmpath:warmpath_password@localhost:5432/warmpath
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
DEBUG=true

# Security & Auth
JWT_SECRET=replace-with-a-secure-random-32-character-secret-key!
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# SMTP / Email (Mailpit local default)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@warmpath.org

# AI (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Payments (Razorpay - TEST MODE ONLY)
# Notice: Test mode only. No real money moves anywhere in the prototype.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Push Notifications (Firebase) & Video Calling
FCM_SERVICE_ACCOUNT_PATH=
JITSI_BASE_URL=https://meet.jit.si

# Domain Defaults: Rating Bands & Payout Shares
PRIOR_MEAN=4.0
PRIOR_WEIGHT=5
TRUSTED_MIN_AVG=4.2
TRUSTED_MIN_SESSIONS=5
TOP_RATED_MIN_AVG=4.6
TOP_RATED_MIN_SESSIONS=10
TOP_RATED_MIN_COMPLETION=0.90

PAYOUT_SHARE_RISING=0.60
PAYOUT_SHARE_TRUSTED=0.70
PAYOUT_SHARE_TOP_RATED=0.80

# Plans and Pricing (INR)
PLAN_CAMPUS_PRICE=0
PLAN_STANDARD_PRICE=299
PLAN_STANDARD_CREDITS=1
PLAN_HIGH_PRICE=499
PLAN_HIGH_CREDITS=2
PLAN_PREMIUM_PRICE=899
PLAN_PREMIUM_CREDITS=4

# Booking Horizons (Days)
BOOKING_HORIZON_STANDARD_DAYS=3
BOOKING_HORIZON_HIGH_DAYS=14
BOOKING_HORIZON_PREMIUM_DAYS=30

# Request Priorities
PRIORITY_STANDARD=1
PRIORITY_HIGH=2
PRIORITY_PREMIUM=3

# Session Rules
SESSION_MIN_CALL_DURATION_MINUTES=5
DISPUTE_WINDOW_HOURS=48
AUTO_REFUND_TIMEOUT_HOURS=72

# Trust Limits (Daily Requests)
DAILY_LIMIT_NEW=3
DAILY_LIMIT_VERIFIED=10
DAILY_LIMIT_ESTABLISHED=25
DAILY_LIMIT_RESTRICTED=1

# Matching Weights
MATCH_WEIGHT_EXPERTISE=0.35
MATCH_WEIGHT_INTENT=0.25
MATCH_WEIGHT_AFFINITY=0.15
MATCH_WEIGHT_AVAILABILITY=0.10
MATCH_WEIGHT_RATING=0.10
MATCH_WEIGHT_RESPONSE_ODDS=0.05

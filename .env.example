# WarmPath Environment Variables
# Copy this file to .env and fill in your values for local development.

# Application
ENVIRONMENT=development
PORT=8000
APP_SECRET_KEY=

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/warmpath

# Cache & State (Redis)
REDIS_URL=redis://localhost:6379/0

# Gemini API (Resume parsing and structured intent extraction)
GEMINI_API_KEY=

# Payments (Razorpay test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Meeting & Calendar Providers (Optional / Mockable for local demo)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
JITSI_BASE_URL=https://meet.jit.si
